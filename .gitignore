__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# Raw and processed data never enter git. Checksums in data/manifests/ do.
data/raw/
data/processed/

# Run outputs stay local unless a run is promoted (see docs/REPRODUCE.md).
results/*
!results/README.md
!results/promoted/
# The snapshot of recorded numbers the paper reads (scripts/records_snapshot.py).
!results/records/
# Every try of the research loop, published with the paper (src/rwm/research/loop.py).
!results/research/
# The tuned-model analyses and the scores of the final, transfer and pooled runs, which the paper is built from
# (paper/Makefile; plan entry of 12 November 2026). Forecasts and checkpoints stay on the results volume.
!results/analysis_tuned/
!results/long_horizon/
!results/paper2/
!results/final/
results/final/*/*
!results/final/*/metrics.json
!results/final/*/manifest.json
!results/ftransfer/
results/ftransfer/*/*
!results/ftransfer/*/metrics.json
!results/ftransfer/*/manifest.json
!results/pooled/
results/pooled/*/*
!results/pooled/*/metrics.json
!results/pooled/*/manifest.json
